# Development image, used by docker-compose.yml.
#
# Runs as root on purpose. Compose bind-mounts ./backend over /app, and a bind
# mount keeps the host's ownership, so a non-root container user can only write
# there if its UID happens to match the host's. That breaks collectstatic on
# Linux and in CI. Dockerfile (the production image) is the one that runs
# non-root, which is where it matters — it ships without a bind mount.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1

COPY --from=ghcr.io/astral-sh/uv:0.9.8 /uv /uvx /bin/

ENV APP_DIR=/app
WORKDIR ${APP_DIR}

COPY pyproject.toml uv.lock ${APP_DIR}
RUN uv sync --locked
ENV PATH="/app/.venv/bin:$PATH"

COPY . ${APP_DIR}
